/** app.wxss - 全局样式与多机型适配 **/

/* ---------- 多机型适配：全局约定 ---------- */
page {
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  box-sizing: border-box;
  /* 顶部安全区域：避免内容顶到状态栏/刘海（自定义导航栏时也可在页面内单独设） */
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
  /* 底部安全区由各页与 custom-tab-bar 自行处理，避免重复 */
}

/* 所有元素默认 border-box，避免宽度计算溢出 */
view, text, image, scroll-view, swiper, button {
  box-sizing: border-box;
}

/* 有底部 TabBar 的页面：给内容区预留 TabBar 高度 + 安全区域，避免被遮挡 */
.page-with-tabbar {
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}