/* miniprogram/custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  /* transform: translateY(-50%); */
  left: 0;
  right: 0;
  height: 100rpx;
  background: white;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1px solid #e0e0e0;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
  position: relative;
  /* margin-top: 50rpx; */
}

.tab-bar-item-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  margin-top: 50rpx;
}

.tab-bar-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.tab-bar-text {
  margin-top: 5px;
  font-size: 20rpx;
  line-height: 1;
}

.tab-bar-item.selected .tab-bar-text {
  color: #1296db;
}

.tab-bar-item.selected .tab-bar-icon {
  /* 选中状态的图标样式 */
}
