/* pages/profile/profile.wxss */
.profile-page {
  background-color: #f5f9ff;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 区域样式 */
.section {
  background: white;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(91, 184, 232, 0.08);
  border: 1rpx solid #e1f5fe;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f9ff;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5bb8e8;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-left: 15rpx;
}

/* 头像上传 */
.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.avatar-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #e1f5fe;
  margin-bottom: 20rpx;
}

.upload-tip {
  display: flex;
  align-items: center;
  color: #5bb8e8;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  background: #f0f9ff;
}

.camera-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 10rpx;
}

/* 表单项目 */
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  min-height: 90rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  width: 180rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
  padding: 10rpx 0;
  min-height: 40rpx;
}

.form-value {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 0;
  min-height: 40rpx;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 15rpx;
  opacity: 0.5;
}

.placeholder {
  color: #ccc !important;
}

/* 文本域 */
.textarea-container {
  position: relative;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #333;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.word-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  color: #999;
}

/* 兴趣爱好标签 */
.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.tag-selected {
  background: linear-gradient(135deg, #87ceeb 0%, #5bb8e8 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(91, 184, 232, 0.2);
}

/* 隐私设置 */
.privacy-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.privacy-item:last-child {
  border-bottom: none;
}

.privacy-label {
  font-size: 28rpx;
  color: #333;
}

.privacy-switch {
  transform: scale(0.9);
}

/* 底部按钮 */
.button-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: white;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.save-button {
  background: #e1f5fe;
  color: #87ceeb;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  height: 88rpx;
  line-height: 88rpx;
  transition: all 0.3s;
  border: none;
}

.save-button::after {
  border: none;
}

.save-button-active {
  background: linear-gradient(135deg, #87ceeb 0%, #5bb8e8 100%);
  color: white;
  box-shadow: 0 8rpx 25rpx rgba(91, 184, 232, 0.3);
}

.save-button-active:active {
  transform: scale(0.98);
}

/* 选择器遮罩 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

/* 禁用输入框样式 */
input[disabled] {
  opacity: 0.6;
  background: #f9f9f9;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section {
  animation: fadeIn 0.5s ease-out;
}

.section:nth-child(2) {
  animation-delay: 0.1s;
}

.section:nth-child(3) {
  animation-delay: 0.2s;
}

.section:nth-child(4) {
  animation-delay: 0.3s;
}

.section:nth-child(5) {
  animation-delay: 0.4s;
}