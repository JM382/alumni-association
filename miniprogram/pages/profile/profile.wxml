<!-- pages/profile/profile.wxml -->
<view class="profile-page">
  <!-- 头像上传区域 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">头像</text>
    </view>
    <view class="avatar-upload" bindtap="chooseAvatar">
      <image class="avatar-image" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="upload-tip">
        <text>点击更换头像</text>
        <image class="camera-icon" src="/icons/camera.png"></image>
      </view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">基本信息</text>
    </view>
    
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input 
        class="form-input" 
        value="{{formData.name}}" 
        placeholder="请输入真实姓名"
        bindinput="onNameChange"
        placeholder-class="placeholder"
      />
    </view>
    
    <view class="form-item">
      <text class="form-label">校友卡号</text>
      <input 
        class="form-input" 
        value="{{formData.alumniNo}}" 
        placeholder="系统自动生成"
        disabled
        placeholder-class="placeholder"
      />
    </view>
    
    <view class="form-item">
      <text class="form-label">手机号码</text>
      <input 
        class="form-input" 
        value="{{formData.phone}}" 
        type="number"
        placeholder="请输入手机号码"
        bindinput="onPhoneChange"
        placeholder-class="placeholder"
        maxlength="11"
      />
    </view>
    
    <view class="form-item">
      <text class="form-label">邮箱</text>
      <input 
        class="form-input" 
        value="{{formData.email}}" 
        type="email"
        placeholder="请输入邮箱"
        bindinput="onEmailChange"
        placeholder-class="placeholder"
      />
    </view>
  </view>

  <!-- 校友信息 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">校友信息</text>
    </view>
    
    <view class="form-item" bindtap="showYearPicker">
      <text class="form-label">入学年份</text>
      <view class="form-value">
        <text class="{{formData.enrollmentYear ? '' : 'placeholder'}}">
          {{formData.enrollmentYear || '请选择入学年份'}}
        </text>
        <image class="arrow-icon" src="/icons/arrow-right.png"></image>
      </view>
    </view>
    
    <view class="form-item" bindtap="showCollegePicker">
      <text class="form-label">所属学院</text>
      <view class="form-value">
        <text class="{{formData.college ? '' : 'placeholder'}}">
          {{formData.college || '请选择所属学院'}}
        </text>
        <image class="arrow-icon" src="/icons/arrow-right.png"></image>
      </view>
    </view>
    
    <view class="form-item">
      <text class="form-label">专业</text>
      <input 
        class="form-input" 
        value="{{formData.major}}" 
        placeholder="请输入所学专业"
        bindinput="onMajorChange"
        placeholder-class="placeholder"
      />
    </view>
    
    <view class="form-item">
      <text class="form-label">班级</text>
      <input 
        class="form-input" 
        value="{{formData.class}}" 
        placeholder="请输入班级"
        bindinput="onClassChange"
        placeholder-class="placeholder"
      />
    </view>
  </view>

  <!-- 个人简介 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">个人简介</text>
    </view>
    <view class="textarea-container">
      <textarea 
        class="form-textarea" 
        value="{{formData.introduction}}" 
        placeholder="介绍一下自己吧（工作经历、兴趣爱好等）"
        bindinput="onIntroductionChange"
        maxlength="200"
        placeholder-class="placeholder"
      />
      <view class="word-count">
        <text>{{formData.introduction ? formData.introduction.length : 0}}/200</text>
      </view>
    </view>
  </view>

  <!-- 工作信息 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">工作信息</text>
    </view>
    
    <view class="form-item">
      <text class="form-label">公司/单位</text>
      <input 
        class="form-input" 
        value="{{formData.company}}" 
        placeholder="请输入公司或单位名称"
        bindinput="onCompanyChange"
        placeholder-class="placeholder"
      />
    </view>
    
    <view class="form-item">
      <text class="form-label">职位</text>
      <input 
        class="form-input" 
        value="{{formData.position}}" 
        placeholder="请输入职位"
        bindinput="onPositionChange"
        placeholder-class="placeholder"
      />
    </view>
    
    <view class="form-item" bindtap="showIndustryPicker">
      <text class="form-label">行业</text>
      <view class="form-value">
        <text class="{{formData.industry ? '' : 'placeholder'}}">
          {{formData.industry || '请选择行业'}}
        </text>
        <image class="arrow-icon" src="/icons/arrow-right.png"></image>
      </view>
    </view>
    
    <view class="form-item">
      <text class="form-label">工作地点</text>
      <input 
        class="form-input" 
        value="{{formData.workLocation}}" 
        placeholder="请输入工作城市"
        bindinput="onWorkLocationChange"
        placeholder-class="placeholder"
      />
    </view>
  </view>

  <!-- 兴趣爱好 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">兴趣爱好</text>
      <text class="section-subtitle">(最多选择5项)</text>
    </view>
    <view class="tags-container">
      <block wx:for="{{hobbyList}}" wx:key="value">
        <view 
          class="tag {{formData.hobbies.indexOf(item.value) !== -1 ? 'tag-selected' : ''}}"
          bindtap="toggleHobby"
          data-value="{{item.value}}"
        >
          <text>{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 隐私设置 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">隐私设置</text>
    </view>
    
    <view class="privacy-item">
      <text class="privacy-label">手机号对校友可见</text>
      <switch 
        class="privacy-switch" 
        checked="{{formData.phoneVisible}}"
        bindchange="onPhoneVisibleChange"
        color="#87ceeb"
      />
    </view>
    
    <view class="privacy-item">
      <text class="privacy-label">邮箱对校友可见</text>
      <switch 
        class="privacy-switch" 
        checked="{{formData.emailVisible}}"
        bindchange="onEmailVisibleChange"
        color="#87ceeb"
      />
    </view>
    
    <view class="privacy-item">
      <text class="privacy-label">工作信息对校友可见</text>
      <switch 
        class="privacy-switch" 
        checked="{{formData.workVisible}}"
        bindchange="onWorkVisibleChange"
        color="#87ceeb"
      />
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="button-container">
    <button 
      class="save-button {{isChanged ? 'save-button-active' : ''}}"
      bindtap="saveProfile"
      disabled="{{!isChanged}}"
    >
      {{isChanged ? '保存修改' : '暂无修改'}}
    </button>
  </view>

  <!-- 选择器组件 -->
  <picker 
    range="{{yearList}}" 
    value="{{yearIndex}}" 
    bindchange="onYearChange" 
    mode="selector"
    wx:if="{{showYearPicker}}"
  >
    <view class="picker-mask" bindtap="hidePickers"></view>
  </picker>
  
  <picker 
    range="{{collegeList}}" 
    value="{{collegeIndex}}" 
    bindchange="onCollegeChange" 
    mode="selector"
    wx:if="{{showCollegePicker}}"
  >
    <view class="picker-mask" bindtap="hidePickers"></view>
  </picker>
  
  <picker 
    range="{{industryList}}" 
    value="{{industryIndex}}" 
    bindchange="onIndustryChange" 
    mode="selector"
    wx:if="{{showIndustryPicker}}"
  >
    <view class="picker-mask" bindtap="hidePickers"></view>
  </picker>
</view>