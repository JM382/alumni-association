/* pages/services/services.wxss */
.services-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fff5f5;
}

.page {
  flex: 1;
  height: 0;
  background: #fff5f5;
}

.header {
  background: #fff;
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  border-bottom: 1rpx solid #eee;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.header-main {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.service-tabs {
  flex: 1;
  overflow: hidden;
}

.benefit-list {
  padding: 24rpx 32rpx;
  padding-bottom: 120rpx;
}

.benefit-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.benefit-header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.benefit-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #c41e3a 0%, #e64545 100%);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.benefit-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.benefit-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.benefit-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.benefit-footer {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.benefit-meta {
  font-size: 22rpx;
  color: #999;
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.benefit-use-btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #c41e3a 0%, #e64545 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

.benefit-use-btn text {
  color: #fff;
}

.benefit-use-btn--hover {
  opacity: 0.9;
}

.return-section {
  padding: 24rpx 32rpx;
  padding-bottom: 120rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin: 24rpx 0 16rpx;
}

.card-title:first-child {
  margin-top: 0;
}

.campus-map-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.campus-map-wrap {
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}

.campus-map {
  width: 100%;
  height: 420rpx;
  display: block;
}

.campus-map-tip {
  display: block;
  padding: 20rpx 24rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.form-group {
  background: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 2rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.submit-btn {
  margin-top: 32rpx;
}

.donate-section {
  padding: 24rpx 32rpx;
  padding-bottom: 120rpx;
}

.donate-intro {
  background: linear-gradient(135deg, rgba(196, 30, 58, 0.08) 0%, rgba(230, 69, 69, 0.06) 100%);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(196, 30, 58, 0.12);
}

.donate-intro-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #c41e3a;
  margin-bottom: 12rpx;
}

.donate-intro-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.55;
}

.donate-launch-btn {
  margin-bottom: 24rpx;
}

.donate-pay-btn {
  margin-top: 20rpx;
}

.donate-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.donate-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.donate-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.donate-target {
  font-size: 24rpx;
  color: #999;
}

.donate-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.donate-progress {
  margin-top: 20rpx;
}

.donate-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.donate-amount-label {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.donate-amounts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 16rpx 0 0;
}

.amount-chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e8e8e8;
  background: #fafafa;
}

.amount-chip text {
  font-size: 26rpx;
  color: #666;
}

.amount-chip--active {
  border-color: #c41e3a;
  background: rgba(196, 30, 58, 0.08);
}

.amount-chip--active text {
  color: #c41e3a;
  font-weight: 500;
}

.donate-custom-box {
  margin: 16rpx 0 8rpx;
  padding: 16rpx 0;
}

.donate-custom-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.donate-payment {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
}

.payment-label {
  margin-right: 8rpx;
}

.payment-name {
  margin-right: 16rpx;
  font-size: 22rpx;
}

.empty-tip {
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  color: #999;
  font-size: 28rpx;
}
