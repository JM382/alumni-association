.chat-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.msg-list {
  padding: 24rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 18rpx;
  align-items: flex-end;
}

.msg-row.other {
  justify-content: flex-start;
}

.msg-row.me {
  justify-content: flex-end;
}

.bubble {
  max-width: 560rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background: #ffffff;
  color: #333;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
  word-break: break-all;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 14rpx;
  background: #f0f0f0;
}

.msg-row.me .bubble {
  background: rgba(176, 30, 43, 0.12);
  border: 1rpx solid rgba(176, 30, 43, 0.18);
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 18rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.composer .input {
  flex: 1;
  height: 72rpx;
  padding: 0 18rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.composer .send {
  height: 72rpx;
  padding: 0 22rpx;
  background: #b01e2b;
  color: #fff;
  border-radius: 12rpx;
}

