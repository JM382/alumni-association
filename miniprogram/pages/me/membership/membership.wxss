/* 会员中心页 - 红色主题，卡片式 */
.membership-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 通用卡片 */
.card,
.status-card,
.plans-card,
.benefit-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #b01e2b;
  margin-bottom: 20rpx;
}

/* 顶部状态卡片 */
.status-card {
  background: linear-gradient(135deg, #8b1a24 0%, #b01e2b 45%, #c42d3a 100%);
  color: #fff;
}

.status-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-left {
  flex: 1;
}

.status-title {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.status-level {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.status-expire {
  font-size: 24rpx;
  opacity: 0.85;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  color: #fff;
}

.status-badge.disabled {
  border-color: rgba(255, 255, 255, 0.5);
  opacity: 0.7;
}

.status-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 套餐列表 */
.plans-card {
}

.plan-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.plan-item:first-child {
  border-top: none;
}

.plan-item-highlight {
  background: #fff9f5;
  border-radius: 16rpx;
  margin: 8rpx -8rpx;
  padding: 24rpx 8rpx;
}

.plan-main {
  flex: 1;
  margin-right: 24rpx;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.plan-desc {
  font-size: 24rpx;
  color: #999;
}

.plan-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.plan-price {
  font-size: 26rpx;
  color: #b01e2b;
  font-weight: 600;
}

.plan-btn {
  min-width: 160rpx;
  height: 60rpx;
  line-height: 36rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  border: none;
}

.plan-btn-active {
  background: #b01e2b;
  color: #fff;
}

.plan-btn-disabled {
  background: #ccc;
  color: #fff;
}

.plan-btn[disabled] {
  opacity: 0.7;
}

/* 权益说明 */
.benefit-card {
}

.benefit-item {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.benefit-item:last-child {
  margin-bottom: 0;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #b01e2b;
  margin-right: 12rpx;
}

.benefit-text {
  font-size: 24rpx;
  color: #666;
}
