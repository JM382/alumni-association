<!-- 个人信息：头像 + 基本信息 + 更多信息，红色主题 -->
<view class="profile-page">
  <!-- 头像卡片 -->
  <view class="card avatar-card">
    <view class="avatar-wrap">
      <image wx:if="{{form.avatarUrl}}" class="avatar" src="{{form.avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
      <view wx:else class="avatar avatar-placeholder">头像</view>
    </view>
    <view class="avatar-btn" bindtap="onChangeAvatar">
      <text>点击更换头像</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="card-title">基本信息</view>
    <view class="form-row">
      <text class="label">校友会身份</text>
      <text class="value">{{identityText || '游客'}}</text>
    </view>
    <view class="form-row">
      <text class="label">昵称</text>
      <input class="input" placeholder="用于个人中心展示" value="{{form.nickname}}" data-field="nickname" bindinput="onFieldInput" />
    </view>
    <view class="form-row">
      <text class="label">手机号码</text>
      <input class="input" type="number" maxlength="11" placeholder="必填" value="{{form.mobile}}" data-field="mobile" bindinput="onFieldInput" />
    </view>
    <view class="form-row">
      <text class="label">邮箱</text>
      <input class="input" type="text" placeholder="必填" value="{{form.email}}" data-field="email" bindinput="onFieldInput" />
    </view>
  </view>

  <!-- 更多信息 -->
  <view class="card">
    <view class="card-title">更多信息</view>
    <picker mode="selector" range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="onGenderChange">
      <view class="form-row">
        <text class="label">性别</text>
        <text class="value {{!form.gender ? 'placeholder' : ''}}">{{genderText}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
    <picker mode="date" value="{{form.birthday}}" start="1900-01-01" end="{{today}}" bindchange="onBirthdayChange">
      <view class="form-row">
        <text class="label">生日</text>
        <text class="value {{!form.birthday ? 'placeholder' : ''}}">{{form.birthday || '请选择'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
    <picker mode="region" bindchange="onRegionChange">
      <view class="form-row">
        <text class="label">所在城市</text>
        <text class="value {{!form.city ? 'placeholder' : ''}}">{{form.city || '请选择'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
    <view class="form-row textarea-row">
      <text class="label">个人简介</text>
      <textarea class="textarea" placeholder="选填" value="{{form.bio}}" data-field="bio" bindinput="onFieldInput" />
    </view>
  </view>

  <view class="save-wrap">
    <button class="save-btn {{hasChanged ? 'save-btn-active' : 'save-btn-disabled'}}"
            disabled="{{!hasChanged || saving}}"
            bindtap="onSubmit">
      保存
    </button>
  </view>
</view>
