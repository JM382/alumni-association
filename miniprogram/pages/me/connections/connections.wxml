<view class="me-page">
  <view class="section-card">
    <view class="section-row">
      <text class="section-title">推荐人脉</text>
      <text class="section-sub">优先推荐与你同校同专业的校友</text>
    </view>
  </view>

  <view class="alumni-list">
    <block wx:if="{{!list.length}}">
      <view class="empty-tip">暂时没有推荐人脉～</view>
    </block>
    <block wx:for="{{list}}" wx:key="userId">
      <view class="alumni-card">
        <image class="alumni-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="alumni-info" data-user-id="{{item.userId}}" bindtap="onTapUser">
          <text class="alumni-name">{{item.nickname}}</text>
          <text class="alumni-desc">
            {{item.schoolName || ''}} {{item.enterYear ? item.enterYear + '级' : ''}} {{item.major || ''}}
          </text>
          <text class="alumni-location">{{item.city || ''}}</text>
        </view>
        <button class="small-btn" size="mini" data-user-id="{{item.userId}}" bindtap="onStartChat">私信</button>
      </view>
    </block>
  </view>
</view>

