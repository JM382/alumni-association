/* 帮助中心 - 红顶栏 + 灰底白卡片，与项目风格一致 */
.help-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 28rpx 0 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 8rpx;
}

/* 常见问题列表 */
.faq-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  min-height: 120rpx;
}

.faq-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.faq-question {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

.faq-answer {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.faq-arrow {
  font-size: 32rpx;
  color: #999;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.faq-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 0 4rpx;
}

/* 联系我们 */
.contact-block {
  padding: 24rpx 0;
}

.contact-label-row {
  margin-bottom: 8rpx;
}

.contact-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.contact-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.contact-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.contact-value-red {
  color: #b01e2b;
  font-weight: 500;
}

.contact-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 0 4rpx;
}
