.auth-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.auth-header {
  margin-bottom: 24rpx;
}

.auth-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.auth-subtitle {
  font-size: 26rpx;
  color: #999;
}

.auth-tabs {
  margin-top: 16rpx;
  display: flex;
  background: #fff;
  border-radius: 999rpx;
  padding: 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.auth-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 16rpx 0;
  border-radius: 999rpx;
}

.auth-tab.active {
  background: #b01e2b;
  color: #fff;
  font-weight: 600;
}

.auth-section {
  margin-top: 24rpx;
}

.status-tip {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.status-text {
  font-weight: 600;
}

.status-none { color: #999; }
.status-pending { color: #ff9800; }
.status-approved { color: #4caf50; }
.status-rejected { color: #e53935; }
.status-canceled { color: #9e9e9e; }

.card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-header {
  font-size: 28rpx;
  color: #666;
  background: #f8f8f8;
  padding: 24rpx 28rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-row:last-child {
  border-bottom: none;
}

.label {
  width: 180rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.textarea-row {
  align-items: flex-start;
}

.textarea {
  flex: 1;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #333;
}

.image-row {
  padding: 20rpx 28rpx 24rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
}

.image-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
}

.image-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.image-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #ddd;
  color: #999;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.save-wrap {
  margin-top: 12rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 56rpx;
  background: #b01e2b;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.save-btn[disabled] {
  opacity: 0.6;
}
