<view class="me-page">
  <view class="section-card">
    <view class="section-row">
      <text class="section-title">通讯录好友</text>
    </view>
  </view>

  <view class="alumni-list">
    <block wx:if="{{!list.length}}">
      <view class="empty-tip">还没有互相关注的好友～</view>
    </block>
    <block wx:for="{{list}}" wx:key="userId">
      <view class="alumni-card">
        <image
          class="alumni-avatar"
          src="{{item.avatarUrl || 'https://636c-cloud1-7g1x07md7360212c-1406143873.tcb.qcloud.la/%E9%BB%98%E8%AE%A4%E5%A4%B4%E5%83%8F.png?sign=102ca8fc2040a7e360a77f4e14a812fa&t=1774595119'}}"
          mode="aspectFill"
          data-user-id="{{item.userId}}"
          bindtap="onTapUser"
        />
        <view class="alumni-info" data-user-id="{{item.userId}}" bindtap="onTapUser">
          <text class="alumni-name">{{item.nickname}}</text>
          <text class="alumni-desc">
            {{item.schoolName || ''}} {{item.enterYear ? item.enterYear + '级' : ''}} {{item.major || ''}}
          </text>
          <text class="alumni-location">{{item.city || ''}}</text>
        </view>
        <button
          class="small-btn"
          size="mini"
          data-user-id="{{item.userId}}"
          data-nickname="{{item.nickname}}"
          data-avatar-url="{{item.avatarUrl}}"
          bindtap="onStartChat"
        >
          私信
        </button>
      </view>
    </block>
  </view>
</view>

