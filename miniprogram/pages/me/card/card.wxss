@import "../me.wxss";

.card-wrapper {
  padding: 40rpx 32rpx;
}

.alumni-card {
  background: linear-gradient(135deg, #8b1a24 0%, #b01e2b 50%, #c42d3a 100%);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
}

.card-school {
  font-size: 24rpx;
  opacity: 0.9;
}

.card-body {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  margin-right: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.2);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.info {
  flex: 1;
}

.name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.line {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 4rpx;
}

.empty-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 60rpx 0;
}

