@import "../me.wxss";
@import "../../circle/circle.wxss";

.order-tabs {
  margin-bottom: 8rpx;
}

.order-list {
  padding: 16rpx 24rpx 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-type-pill {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #fde6e8;
  color: #b01e2b;
  font-size: 22rpx;
}

.order-status {
  font-size: 24rpx;
  color: #ff9800;
}

.order-body {
  margin-bottom: 12rpx;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.order-partner {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 2rpx;
}

.order-time {
  font-size: 22rpx;
  color: #999;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-amount {
  font-size: 30rpx;
  color: #b01e2b;
  font-weight: 600;
}

.order-btn {
  background: #b01e2b;
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

