/* 隐私设置 - 红顶栏 + 分区卡片 + 开关，与项目风格一致 */
.privacy-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  font-size: 28rpx;
  color: #666;
  background: #f8f8f8;
  padding: 24rpx 28rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}

.setting-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.setting-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  line-height: 1.4;
}
