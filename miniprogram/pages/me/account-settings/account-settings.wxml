<view class="account-settings-page">
  <!-- 账号安全 -->
  <view class="card">
    <view class="section-header">账号安全</view>
    <view class="row" bindtap="onMobileTap">
      <view class="row-left">
        <text class="row-label">手机号</text>
        <text class="row-desc">用于登录与找回密码</text>
      </view>
      <view class="row-right">
        <text class="row-value">{{mobile || '未绑定'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="row" bindtap="onDeviceManageTap">
      <view class="row-left">
        <text class="row-label">登录设备管理</text>
        <text class="row-desc">查看已登录设备,可远程退出</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 账号管理 -->
  <view class="card">
    <view class="section-header">账号管理</view>
    <view class="row row-danger" bindtap="onDeregisterTap">
      <view class="row-left">
        <text class="row-label">注销账号</text>
        <text class="row-desc">注销后数据将无法恢复,请谨慎操作</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="row" bindtap="onLogoutTap">
      <view class="row-left">
        <text class="row-label">退出账号</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
