@import "../me.wxss";

.form-card {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-input {
  width: 100%;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
  font-size: 26rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
  font-size: 26rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #e6e6e6;
  color: #999;
  font-size: 30rpx;
}

.submit-btn.active {
  background: #b01e2b;
  color: #fff;
}

.submit-btn.disabled {
  background: #e6e6e6;
  color: #999;
}

.media-card {
  margin-top: 6rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fafafa;
  border: 1rpx solid #eee;
}

.media-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.media-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
}

.media-tip {
  font-size: 22rpx;
  color: #999;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-item {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  background: #f2f2f2;
}

.media-img {
  width: 100%;
  height: 100%;
}

.media-video {
  width: 100%;
  height: 100%;
}

.media-video-player {
  width: 100%;
  height: 100%;
}

.media-remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.media-add {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #ddd;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.media-add-plus {
  font-size: 46rpx;
  line-height: 1;
}

.media-add-text {
  margin-top: 6rpx;
  font-size: 22rpx;
}

