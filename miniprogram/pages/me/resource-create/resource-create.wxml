<view class="me-page">
  <view class="section-card">
    <view class="section-row">
      <text class="section-title">{{category === 'help' ? '发布求助' : '发布资源'}}</text>
    </view>
  </view>

  <view class="form-card">
    <input
      class="form-input"
      placeholder="请输入标题，如：求北京产品实习内推"
      value="{{title}}"
      bindinput="onTitleInput"
    />
    <textarea
      class="form-textarea"
      placeholder="请详细描述你的资源或需求"
      value="{{content}}"
      bindinput="onContentInput"
    />
    <input
      class="form-input"
      placeholder="标签（如：实习内推 / 学习资料）"
      value="{{tag}}"
      bindinput="onTagInput"
    />
    <input
      class="form-input"
      placeholder="联系方式（公开展示，如：微信号/手机号）"
      value="{{contact}}"
      bindinput="onContactInput"
    />

    <view class="media-card">
      <view class="media-head">
        <text class="media-title">图片/视频</text>
        <text class="media-tip">最多9张图或1个视频</text>
      </view>
      <view class="media-grid">
        <block wx:for="{{mediaList}}" wx:key="tempFilePath">
          <view class="media-item">
            <image wx:if="{{item.type === 'image'}}" class="media-img" src="{{item.tempFilePath}}" mode="aspectFill" />
            <view wx:elif="{{item.type === 'video'}}" class="media-video">
              <video class="media-video-player" src="{{item.tempFilePath}}" controls></video>
            </view>
            <view class="media-remove" data-index="{{index}}" bindtap="onRemoveMedia">×</view>
          </view>
        </block>
        <view class="media-add" bindtap="onChooseMedia">
          <text class="media-add-plus">＋</text>
          <text class="media-add-text">添加</text>
        </view>
      </view>
    </view>

    <button
      class="submit-btn {{canSubmit ? 'active' : 'disabled'}}"
      loading="{{submitting}}"
      disabled="{{!canSubmit || submitting}}"
      bindtap="onSubmit"
    >
      发布
    </button>
  </view>
</view>

