@import "../me.wxss";

.res-tabs,
.res-tab,
.res-tab.active,
.res-tab-right {
  display: none;
}

.res-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 18rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.res-top-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #333;
}

.res-publish-btn {
  background: #b01e2b;
  color: #fff;
  border-radius: 999rpx;
  padding: 0 22rpx;
}

.res-list {
  padding: 24rpx;
}

.res-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.res-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.res-user {
  display: flex;
  align-items: center;
}

.res-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 14rpx;
}

.res-user-meta {
  display: flex;
  flex-direction: column;
}

.res-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.res-sub {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #999;
}

.res-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fde6e8;
  color: #b01e2b;
  font-size: 22rpx;
}

.res-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 8rpx;
}

.res-content {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

.res-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.res-img {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.res-video-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #b01e2b;
}

.res-contact {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: #fafafa;
  border: 1rpx solid #eee;
}

.res-contact-label {
  font-size: 22rpx;
  color: #999;
}

.res-contact-value {
  font-size: 24rpx;
  color: #333;
  margin-left: 8rpx;
}

.res-actions {
  display: flex;
  justify-content: flex-end;
  gap: 26rpx;
  margin-top: 14rpx;
}

.res-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #666;
}

.res-icon {
  font-size: 30rpx;
}

.res-text {
  font-size: 24rpx;
}

