<view class="me-page user-profile-page">
  <view class="me-header">
    <view class="user-block">
      <view class="avatar-wrap">
        <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar avatar-placeholder">头像</view>
        <view class="badge badge-unverified">
          {{user.identity == 'alumni' ? '已认证' : '未认证'}}
        </view>
      </view>
      <view class="user-meta">
        <text class="user-name">{{user.nickname || '校友'}}</text>
        <text class="user-status">{{user.identityText || '游客'}}</text>
        <text class="user-college">
          {{user.schoolName || ''}} {{user.enterYear ? user.enterYear + '级' : ''}} {{user.major || ''}}
        </text>
      </view>
    </view>

    <view class="profile-actions">
      <button class="btn-follow" loading="{{followLoading}}" disabled="{{followLoading || isSelf}}" bindtap="onToggleFollow">
        <block wx:if="{{isSelf}}">本人</block>
        <block wx:elif="{{isMutual}}">互相关注</block>
        <block wx:elif="{{following}}">已关注</block>
        <block wx:else>关注</block>
      </button>
      <button class="btn-message" loading="{{msgLoading}}" disabled="{{msgLoading || isSelf}}" bindtap="onStartChat">
        发私信
      </button>
    </view>
  </view>

  <view class="profile-section">
    <view class="profile-card">
      <view class="profile-row">
        <text class="profile-label">所在学校</text>
        <text class="profile-value">{{user.schoolName || '未填写'}}</text>
      </view>
      <view class="profile-row">
        <text class="profile-label">专业</text>
        <text class="profile-value">{{user.major || '未填写'}}</text>
      </view>
      <view class="profile-row">
        <text class="profile-label">入学年份</text>
        <text class="profile-value">{{user.enterYear || '未填写'}}</text>
      </view>
      <view class="profile-row">
        <text class="profile-label">当前城市</text>
        <text class="profile-value">{{user.city || '未填写'}}</text>
      </view>
      <view class="profile-row">
        <text class="profile-label">手机号</text>
        <text class="profile-value">{{user.mobile || '未填写'}}</text>
      </view>
      <view class="profile-row">
        <text class="profile-label">邮箱</text>
        <text class="profile-value">{{user.email || '未填写'}}</text>
      </view>
    </view>
  </view>
</view>

