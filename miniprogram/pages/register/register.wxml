<!--pages/register/register.wxml-->
<view class="page">
  <view class="form">
    <view class="form-title">请完善您的校友信息</view>

    <view class="form-group">
      <text class="form-label">校友卡号</text>
      <t-input
        value="{{form.alumniCardNo}}"
        placeholder="请输入校友卡号"
        clearable
        bind:change="onAlumniCardNoChange"
      />
    </view>

    <view class="form-group">
      <text class="form-label">入学年份</text>
      <t-input
        value="{{form.enrollYear}}"
        type="number"
        placeholder="如：2015"
        clearable
        bind:change="onEnrollYearChange"
      />
    </view>

    <view class="form-group">
      <text class="form-label">院系</text>
      <t-input
        value="{{form.department}}"
        placeholder="如：计算机学院、经济学院"
        clearable
        bind:change="onDepartmentChange"
      />
    </view>

    <view class="form-group">
      <text class="form-label">手机号</text>
      <t-input
        value="{{form.phone}}"
        type="number"
        placeholder="请输入手机号"
        clearable
        bind:change="onPhoneChange"
      />
    </view>

    <view class="form-group">
      <text class="form-label">邮箱</text>
      <t-input
        value="{{form.email}}"
        placeholder="选填，请输入邮箱"
        clearable
        bind:change="onEmailChange"
      />
    </view>

    <t-button
      theme="primary"
      block
      size="large"
      class="submit-btn"
      loading="{{submitting}}"
      bindtap="onSubmit"
    >
      提交并完成注册
    </t-button>
  </view>
</view>
