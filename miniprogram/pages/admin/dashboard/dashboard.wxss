.admin-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #fff7f8;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #b01e2b 0%, #c92a3a 100%);
  border-radius: 20rpx;
  padding: 28rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.menu-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(176, 30, 43, 0.12);
}

.menu-item {
  height: 96rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.menu-title {
  font-size: 30rpx;
  color: #2b2b2b;
}

.menu-arrow {
  font-size: 38rpx;
  color: #b01e2b;
  line-height: 1;
}

.empty {
  margin-top: 60rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.actions {
  margin-top: 24rpx;
}

.exit-btn {
  background: #b01e2b;
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.exit-btn::after {
  border: none;
}
