.detail-page {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
  background: #fff7f8;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid rgba(176, 30, 43, 0.12);
}

.title {
  font-size: 30rpx;
  font-weight: 700;
  color: #b01e2b;
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 8rpx;
}

.label {
  color: #666;
  font-size: 26rpx;
}

.value {
  color: #222;
  font-size: 26rpx;
  text-align: right;
  flex: 1;
}

.images {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
}

.actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.btn::after {
  border: none;
}

.btn.reject {
  background: #f2f2f2;
  color: #666;
}

.btn.approve {
  background: #b01e2b;
  color: #fff;
}

.empty {
  text-align: center;
  margin-top: 100rpx;
  color: #999;
  font-size: 28rpx;
}
