@import "../../me/me.wxss";

.detail-card {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.detail-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.detail-sub {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 24rpx;
  color: #666;
}

.value {
  font-size: 24rpx;
  color: #333;
  max-width: 70%;
  text-align: right;
}

.gray {
  color: #999;
}

.green {
  color: #2e7d32;
}

.actions {
  padding: 0 24rpx 40rpx;
}

.primary-btn {
  width: 100%;
  height: 80rpx;
  line-height: 50rpx;
  border-radius: 999rpx;
  background: #b01e2b;
  color: #fff;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.empty-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 80rpx 0;
}

