.event-page {
  background: #f5f5f5;
  min-height: 100vh;
}

.event-cover {
  width: 100%;
  height: 320rpx;
  background: #f0f0f0;
}

.event-main {
  padding: 24rpx;
  background: #fff;
}

.event-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.event-sub {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.event-brief {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fde6e8;
  color: #b01e2b;
  font-size: 24rpx;
}

.event-content {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.7;
  white-space: pre-wrap;
}

.event-footer {
  padding: 16rpx 24rpx 40rpx;
  background: #f5f5f5;
}

.event-btn {
  width: 100%;
  height: 80rpx;
  line-height: 50rpx;
  border-radius: 999rpx;
  background: #b01e2b;
  color: #fff;
  font-size: 30rpx;
}

.empty-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 80rpx 0;
}

