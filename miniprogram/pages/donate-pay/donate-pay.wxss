.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
  background: #fff5f5;
}

.state-wrap {
  padding: 120rpx 32rpx;
}

.state-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
}

.intro {
  margin-bottom: 24rpx;
}

.intro-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.intro-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.55;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.section-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  line-height: 1.45;
}

.donate-amounts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.amount-chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e8e8e8;
  background: #fafafa;
}

.amount-chip text {
  font-size: 26rpx;
  color: #666;
}

.amount-chip--active {
  border-color: #c41e3a;
  background: rgba(196, 30, 58, 0.08);
}

.amount-chip--active text {
  color: #c41e3a;
  font-weight: 500;
}

.custom-box {
  margin-top: 20rpx;
}

.custom-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.submit-btn {
  margin-top: 8rpx;
}

.pay-footer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.pay-footer-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.pay-footer-name {
  font-size: 24rpx;
  color: #666;
}
