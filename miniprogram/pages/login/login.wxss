/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #87ceeb 0%, #f5f9ff 100%);
  display: flex;
  flex-direction: column;
}

/* 顶部区域 */
.login-header {
  padding: 80rpx 0 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: white;
}

.login-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 30rpx;
  background: white;
}

.login-title {
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.login-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 登录表单 */
.login-form {
  flex: 1;
  background: white;
  border-radius: 50rpx 50rpx 0 0;
  padding: 60rpx 50rpx;
  margin-top: -30rpx;
}

/* 按钮通用样式 */
.btn-wechat, .btn-login, .btn-continue, .btn-logout, .btn-guest {
  width: 100%;
  border: none;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 30rpx 0;
  margin-bottom: 30rpx;
  transition: all 0.3s;
}

.btn-wechat::after, .btn-login::after, .btn-continue::after, 
.btn-logout::after, .btn-guest::after {
  border: none;
}

.btn-hover {
  opacity: 0.9;
  transform: translateY(-2rpx);
}

/* 微信登录按钮 */
.btn-wechat {
  background: #07C160;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.divider-text {
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #999;
}

/* 表单输入 */
.form-section {
  margin-bottom: 40rpx;
}

.input-group {
  position: relative;
  margin-bottom: 30rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 50rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  transition: border-color 0.3s;
}

.input-group:focus-within {
  border-color: #87ceeb;
}

.input-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  opacity: 0.5;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  padding: 25rpx 0;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-code {
  background: #87ceeb;
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 15rpx 30rpx;
  font-size: 26rpx;
  min-width: 160rpx;
}

.btn-code::after {
  border: none;
}

.btn-disabled {
  background: #cccccc !important;
  color: #999999 !important;
}

/* 登录按钮 */
.btn-login {
  background: linear-gradient(135deg, #87ceeb 0%, #5bb8e8 100%);
  color: white;
  box-shadow: 0 8rpx 25rpx rgba(91, 184, 232, 0.3);
}

.btn-login[disabled] {
  background: #cccccc !important;
  color: #999999 !important;
  box-shadow: none;
}

/* 服务协议 */
.agreement {
  text-align: center;
  margin-top: 30rpx;
}

.checkbox-label {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
}

checkbox {
  transform: scale(0.8);
  margin-right: 10rpx;
}

.agreement-text {
  margin-right: 5rpx;
}

.agreement-link {
  color: #5bb8e8;
  margin: 0 5rpx;
}

/* 已登录状态 */
.logged-view {
  flex: 1;
  background: white;
  border-radius: 50rpx 50rpx 0 0;
  padding: 80rpx 50rpx;
  margin-top: -30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #87ceeb;
  margin-bottom: 30rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.user-welcome {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.btn-continue {
  background: linear-gradient(135deg, #87ceeb 0%, #5bb8e8 100%);
  color: white;
  margin-bottom: 20rpx;
}

.btn-logout {
  background: #f5f5f5;
  color: #666;
}

/* 游客模式 */
.guest-view {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid #e0e0e0;
}

.guest-divider {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.guest-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.guest-text {
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #999;
}

.btn-guest {
  background: #f5f5f5;
  color: #666;
  margin-bottom: 20rpx;
}

.guest-tips {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* 加载中动画 */
.loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
  margin-top: 20rpx;
}