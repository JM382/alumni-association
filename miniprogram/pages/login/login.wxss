/* pages/login/login.wxss - 仅微信一键登录 */

.login-page {
  min-height: 100vh;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
}

/* 顶部红色背景 */
.login-header {
  padding: 120rpx 0 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #b01e2b;
  color: #ffffff;
}

.login-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-bottom: 30rpx;
  background-color: #ffffff;
}

.login-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.login-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 中间按钮区域 */
.login-body {
  flex: 1;
  padding: 80rpx 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 微信一键登录按钮 */
.btn-wechat {
  width: 100%;
  border: none;
  border-radius: 50rpx;
  background-color: #b01e2b;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-wechat[disabled] {
  background-color: #909090;
  color: #909090;
}

.btn-wechat::after {
  border: none;
}

.btn-hover {
  opacity: 0.9;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

/* 底部协议区域 */
.login-footer {
  padding: 20rpx 40rpx 40rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666666;
}

checkbox {
  transform: scale(0.8);
  margin-right: 8rpx;
}

.agreement-text {
  margin: 0 4rpx;
}

.agreement-link {
  color: #b01e2b;
  margin: 0 4rpx;
}