/* pages/news/news.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fff5f5;
}

.header {
  background: #fff;
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  border-bottom: 1rpx solid #eee;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.header-main {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.news-tabs {
  flex-shrink: 0;
}

.news-list {
  flex: 1;
  overflow-y: auto;
}

.news-item {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  margin-bottom: 2rpx;
}

.news-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.news-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.news-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.news-summary {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.news-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
  display: flex;
  justify-content: space-between;
}

.news-actions {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.news-delete {
  font-size: 24rpx;
  color: #c41e3a;
  padding: 8rpx 16rpx;
}

.empty-tip {
  padding: 80rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
