/* pages/home/home.wxss */
.page {
  height: 100vh;
  background: #fff5f5;
}

.header {
  background: linear-gradient(135deg, #c41e3a 0%, #e64545 100%);
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-title {
  display: flex;
  flex-direction: column;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-main {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.user-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.95);
  padding: 12rpx 24rpx;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-search {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
}

.search-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
}

.section {
  padding: 24rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #c41e3a;
}

.section-hint {
  font-size: 24rpx;
  color: #999;
}

.section-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  max-width: 72%;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.section-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.divider {
  color: #ddd;
}

/* 首页 Banner 轮播（原生 swiper，避免 t-swiper 的 click 在部分环境下无法绑定页面方法） */
.home-banner-swiper {
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.home-banner-img {
  display: block;
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
}

/* Grid 快捷入口 */
.section .t-grid {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.feed-empty {
  padding: 48rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
  text-align: center;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-item {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.feed-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.feed-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.feed-tag {
  align-self: flex-start;
  margin-bottom: 8rpx;
}

.feed-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.feed-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
  display: flex;
  justify-content: space-between;
}
