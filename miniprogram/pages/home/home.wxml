<!--pages/home/home.wxml-->
<scroll-view scroll-y class="page" enhanced show-scrollbar="{{false}}">
  <!-- 顶部 Header -->
  <view class="header">
    <view class="header-content">
      <view class="header-title">
        <text class="header-subtitle">校友服务</text>
        <text class="header-main">校友之家</text>
      </view>
      <view wx:if="{{userNickName}}" class="user-name" bindtap="onUserNameTap">{{userNickName}}</view>
    </view>
    <view class="header-search">
      <t-icon name="search" size="32rpx" />
      <text class="search-text">发现你可能感兴趣的校友活动和校园资讯</text>
    </view>
  </view>

  <!-- Banner 轮播 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">母校动态 · 校友活动</text>
      <text class="section-more">查看更多</text>
    </view>
    <swiper
      class="home-banner-swiper"
      autoplay
      circular
      interval="4000"
      duration="500"
      indicator-dots
      indicator-color="rgba(0,0,0,0.25)"
      indicator-active-color="#c41e3a"
    >
      <swiper-item
        wx:for="{{bannerList}}"
        wx:key="index"
        bindtap="onBannerItemTap"
        data-index="{{index}}"
      >
        <image class="home-banner-img" src="{{item.value}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
  </view>

  <!-- 快捷功能入口 8个 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">快捷服务</text>
      <text class="section-hint">8 个核心入口</text>
    </view>
    <t-grid column="4" border="{{false}}">
      <t-grid-item
        wx:for="{{shortcuts}}"
        wx:key="key"
        text="{{item.label}}"
        icon="{{item.icon}}"
        bindtap="onShortcutTap"
        data-key="{{item.key}}"
      />
    </t-grid>
  </view>

  <!-- 动态推送区（数据来自云数据库 news_posts） -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">动态推送</text>
      <view class="section-header-right">
        <view class="section-tags">
          <text>校友故事</text>
          <text class="divider">|</text>
          <text>母校新闻</text>
          <text class="divider">|</text>
          <text>招聘 · 活动</text>
        </view>
        <text class="section-more" bindtap="onNewsMoreTap">更多</text>
      </view>
    </view>
    <view wx:if="{{feedList.length === 0}}" class="feed-empty">
      <text>暂无资讯，请稍后在「资讯」页查看或发布校友动态</text>
    </view>
    <view wx:else class="feed-list">
      <view
        class="feed-item"
        wx:for="{{feedList}}"
        wx:key="id"
        bindtap="onFeedTap"
        data-id="{{item.id}}"
      >
        <image class="feed-thumb" src="{{item.thumb}}" mode="aspectFill" />
        <view class="feed-content">
          <t-tag theme="primary" variant="light" size="small" class="feed-tag">{{item.category}}</t-tag>
          <text class="feed-title">{{item.title}}</text>
          <view class="feed-meta">
            <text>{{item.time}}</text>
            <text>浏览量 {{item.views}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
