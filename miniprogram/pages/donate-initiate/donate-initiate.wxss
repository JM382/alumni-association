.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
  background: #fff5f5;
}

.intro {
  margin-bottom: 24rpx;
}

.intro-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.intro-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.55;
}

.intro-tip {
  display: block;
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(196, 30, 58, 0.06);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.section-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  line-height: 1.45;
}

.submit-btn {
  margin-top: 16rpx;
}
