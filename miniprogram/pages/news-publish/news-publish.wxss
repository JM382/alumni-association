/* pages/news-publish/news-publish.wxss */
.page {
  height: 100vh;
  background: #fff5f5;
}

.form {
  padding: 24rpx 32rpx;
  padding-bottom: 120rpx;
}

.form-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #ffebee;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #c41e3a;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.form-tip-icon {
  flex-shrink: 0;
  font-size: 28rpx;
}

.form-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-row:last-child {
  border-bottom: none;
}

.picker-label {
  color: #666;
  width: 180rpx;
  flex-shrink: 0;
}

.picker-value {
  flex: 1;
  color: #333;
  text-align: right;
}

.picker-arrow {
  margin-left: 12rpx;
  color: #ccc;
  font-size: 36rpx;
  line-height: 1;
}

.schedule-pickers {
  margin-top: 8rpx;
}

.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-tag {
  margin-right: 0;
}

.admin-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
}

.admin-row:not(:last-child) {
  border-bottom: 1rpx solid #eee;
}

.form-footer {
  margin-top: 32rpx;
}

.footer-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.footer-btns {
  display: flex;
  gap: 24rpx;
  justify-content: flex-end;
}
