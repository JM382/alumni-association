/* pages/circle/circle.wxss */
.circle-page {
  background-color: #f5f9ff;
  min-height: 100vh;
}

/* 顶部功能栏 */
.top-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
}

.search-container {
  flex: 1;
  margin-right: 20rpx;
}

.search-input {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #f5f5f5;
  border-radius: 50rpx;
  color: #999;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 15rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
}

.publish-btn {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #87ceeb 0%, #5bb8e8 100%);
  color: white;
  padding: 15rpx 30rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}

.publish-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

/* 导航选项卡 */
.nav-tabs {
  display: flex;
  background: white;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #eee;
}

.nav-item {
  flex: 1;
  text-align: center;
  padding: 25rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.nav-active {
  color: #5bb8e8;
  font-weight: bold;
}

.nav-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #5bb8e8;
  border-radius: 2rpx;
  opacity: 0;
}

.nav-active .nav-indicator {
  opacity: 1;
}

/* 动态卡片 */
.post-list {
  padding: 20rpx;
}

.post-card {
  background: white;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.post-user-info {
  flex: 1;
}

.post-username {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.post-user-desc {
  font-size: 24rpx;
  color: #999;
}

.post-time {
  font-size: 24rpx;
  color: #ccc;
}

.post-content {
  margin-bottom: 20rpx;
}

.post-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.post-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.action-item {
  display: flex;
  align-items: center;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.action-count {
  font-size: 26rpx;
  color: #999;
}

/* 活动卡片 */
.activity-list {
  padding: 20rpx;
}

.activity-card {
  background: white;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.activity-type {
  background: #5bb8e8;
  color: white;
  padding: 6rpx 15rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.activity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin: 15rpx 0;
  display: block;
}

.activity-info {
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.info-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.activity-btn {
  background: #5bb8e8;
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 15rpx 30rpx;
  font-size: 28rpx;
}

/* 校友卡片 */
.alumni-list {
  padding: 20rpx;
}

.alumni-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.alumni-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.alumni-info {
  flex: 1;
}

.alumni-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 5rpx;
}

.alumni-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 5rpx;
}

.alumni-location {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.chat-btn {
  background: #5bb8e8;
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

/* 弹窗 */
.publish-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.modal-content {
  background: white;
  width: 100%;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  position: relative;
  z-index: 1001;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  width: 40rpx;
  height: 40rpx;
}

.publish-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 30rpx;
  padding: 20rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.publish-btn-submit {
  background: #5bb8e8;
  color: white;
  border: none;
  border-radius: 50rpx;
  font-size: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
}

/* 话题标签 */
.topic-scroll {
  white-space: nowrap;
  padding: 20rpx;
  background: white;
}

.topic-list {
  display: inline-flex;
}

.topic-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 15rpx;
}

.topic-active {
  background: #5bb8e8;
  color: white;
}

/* 筛选面板 */
.filter-panel {
  background: white;
  padding: 20rpx;
}

.filter-item {
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 15rpx 20rpx;
}

.picker-view {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}