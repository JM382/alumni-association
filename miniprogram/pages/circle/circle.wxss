@import "../me/me.wxss";

.circle-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 顶部三个切换键 */
.tabs {
  margin: 16rpx 24rpx 8rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 4rpx;
  display: flex;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 999rpx;
}

.tab-item.active {
  background: #b01e2b;
  color: #fff;
  font-weight: 600;
}

.tab-panel {
  padding: 16rpx 24rpx 24rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.toolbar-right {
  display: flex;
  gap: 12rpx;
}

.toolbar-btn {
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  border: 1rpx solid #ccc;
  background: #fff;
  color: #666;
}

.toolbar-btn.primary {
  border-color: #b01e2b;
  background: #b01e2b;
  color: #fff;
}

.post-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.post-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.post-user-touch {
  display: flex;
  align-items: center;
  flex: 1;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #eee;
}

.post-user-info {
  flex: 1;
}

.post-username {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.post-user-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-time {
  font-size: 22rpx;
  color: #ccc;
}

.post-content {
  margin-bottom: 12rpx;
}

.post-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.post-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
}

.action-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.action-text {
  font-size: 26rpx;
  color: #666;
}

.empty-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 60rpx 0;
}

/* 活动列表（报名入口） */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.activity-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.activity-cover {
  width: 100%;
  height: 260rpx;
  background: #f0f0f0;
}

.activity-main {
  padding: 20rpx 24rpx;
}

.activity-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.activity-sub {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 2rpx;
}

.activity-brief {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 找校友筛选与列表 */
.alumni-filter-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.alumni-filter-row {
  display: flex;
  gap: 12rpx;
}

.alumni-filter-item {
  flex: 1;
}

.alumni-filter-pill {
  width: 100%;
  background: #f5f5f5;
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

/* ===== 底部选择器（自定义）===== */
.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9998;
}

.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 9999;
  overflow: hidden;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-cancel,
.picker-ok {
  font-size: 26rpx;
  color: #b01e2b;
  width: 120rpx;
}

.picker-ok {
  text-align: right;
}

.picker-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.picker-list {
  max-height: 60vh;
}

.picker-item {
  padding: 26rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
}

.picker-item:active {
  background: #f8f8f8;
}

.alumni-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.alumni-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.alumni-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #eee;
}

.alumni-info {
  flex: 1;
}

.alumni-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.alumni-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.alumni-location {
  font-size: 22rpx;
  color: #999;
}

.fab-wrap {
  position: fixed;
  right: 40rpx;
  bottom: calc(140rpx + constant(safe-area-inset-bottom));
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  z-index: 1000;
}

.fab-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #b01e2b;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.25);
}

.fab-plus {
  color: #fff;
  font-size: 44rpx;
}

/* pages/circle/circle.wxss - 校友圈，底部留出 TabBar + 安全区域 */
.circle-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 顶部红色头部 */
.circle-header {
  background: linear-gradient(180deg, #8b1a24 0%, #b01e2b 40%, #c42d3a 100%);
  padding: 32rpx 32rpx 40rpx;
  color: #fff;
}

.header-main {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-left {
  flex: 1;
}

.header-title {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.header-sub {
  font-size: 24rpx;
  opacity: 0.9;
}

.header-right {
  margin-left: 16rpx;
}

.publish-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.publish-plus {
  font-size: 30rpx;
  margin-right: 6rpx;
}

.publish-text {
  font-size: 24rpx;
}

.header-search {
  margin-top: 12rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

