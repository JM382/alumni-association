/* 校友卡片 */
.alumni-list {
  padding: 20rpx;
}

.alumni-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.alumni-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.alumni-info {
  flex: 1;
}

.alumni-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 5rpx;
}

.alumni-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 5rpx;
}

.alumni-location {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.chat-btn {
  background: #b01e2b;
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

/* 弹窗 */
.publish-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.modal-content {
  background: white;
  width: 100%;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  position: relative;
  z-index: 1001;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  width: 40rpx;
  height: 40rpx;
}

.publish-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 30rpx;
  padding: 20rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.publish-btn-submit {
  background: #b01e2b;
  color: white;
  border: none;
  border-radius: 50rpx;
  font-size: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
}

/* 话题标签 */
.topic-scroll {
  white-space: nowrap;
  padding: 20rpx;
  background: white;
}

.topic-list {
  display: inline-flex;
}

.topic-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 15rpx;
}

.topic-active {
  background: #b01e2b;
  color: white;
}

.filter-row {
  display: flex;
  gap: 12rpx;
}

.filter-item {
  flex: 1;
}

.picker-view {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

/* 区块标题行 */
.section-card {
  margin: 16rpx 24rpx 8rpx;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.small-btn {
  background: #b01e2b;
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

/* 筛选面板 */
.filter-panel {
  background: white;
  padding: 20rpx;
}

.filter-item {
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 15rpx 20rpx;
}

.picker-view {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}