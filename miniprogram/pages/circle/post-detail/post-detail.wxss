.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.post-card {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #eee;
}

.meta {
  flex: 1;
}

.name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.sub {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.content {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.images {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.section-title {
  margin: 8rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.comment-list {
  padding: 0 24rpx;
}

.empty {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 60rpx 0;
}

.comment-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
}

.c-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #eee;
}

.c-body {
  flex: 1;
}

.c-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.c-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.c-reply {
  font-size: 24rpx;
  color: #b01e2b;
}

.c-content {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.replies {
  margin-top: 10rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  background: #f7f7f7;
}

.reply-item {
  padding: 6rpx 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.reply-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 600;
}

.reply-content {
  font-size: 24rpx;
  color: #333;
}

.reply-action {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #b01e2b;
}

.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: constant(safe-area-inset-bottom);
  bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  padding: 12rpx 16rpx 16rpx;
}

.replying {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 10rpx;
}

.replying-text {
  font-size: 22rpx;
  color: #666;
}

.replying-cancel {
  font-size: 22rpx;
  color: #b01e2b;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.input {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.send {
  background: #b01e2b;
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

