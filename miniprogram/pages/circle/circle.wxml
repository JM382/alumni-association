<view class="circle-page page-with-tabbar">
  <!-- 三个切换键 -->
  <view class="tabs">
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" data-tab="0" bindtap="onChangeTab">
      动态
    </view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" data-tab="1" bindtap="onChangeTab">
      活动
    </view>
    <view class="tab-item {{currentTab === 2 ? 'active' : ''}}" data-tab="2" bindtap="onChangeTab">
      找校友
    </view>
  </view>

  <!-- 动态 -->
  <view wx:if="{{currentTab === 0}}" class="tab-panel">
    <view class="toolbar">
      <view class="toolbar-left"></view>
      <view class="toolbar-right">
        <button class="toolbar-btn" size="mini" bindtap="onViewInteractions">互动历史</button>
        <button class="toolbar-btn primary" size="mini" bindtap="onGoPublish">发动态</button>
      </view>
    </view>

    <view class="post-list">
      <block wx:if="{{posts.length === 0}}">
        <view class="empty-tip">还没有动态，快去发布第一条吧～</view>
      </block>
      <block wx:for="{{posts}}" wx:key="_id">
        <view class="post-card">
          <view class="post-header">
            <view class="post-user-touch" data-user-id="{{item.userId || item.user.userId}}" bindtap="onTapUser">
              <image class="post-avatar" src="{{item.user.avatarUrl || 'https://636c-cloud1-7g1x07md7360212c-1406143873.tcb.qcloud.la/%E9%BB%98%E8%AE%A4%E5%A4%B4%E5%83%8F.png?sign=102ca8fc2040a7e360a77f4e14a812fa&t=1774595119'}}" mode="aspectFill" />
              <view class="post-user-info">
                <view class="post-username">{{item.user.nickname || '校友'}}</view>
                <view class="post-user-desc">
                  {{item.user.enterYear || ''}}级 {{item.user.major || ''}}
                </view>
              </view>
            </view>
            <text class="post-time">{{item.timeText}}</text>
          </view>
          <view class="post-content">
            <text class="post-text">{{item.content}}</text>
          </view>
          <view wx:if="{{item.images && item.images.length}}" class="post-images">
            <block wx:for="{{item.images}}" wx:key="*this">
              <image class="post-image" src="{{item}}" mode="aspectFill" />
            </block>
          </view>
          <view class="post-actions">
            <view class="action-item" bindtap="onToggleLike" data-id="{{item._id}}">
              <text class="action-icon">{{item.hasLiked ? '♥' : '♡'}}</text>
              <text class="action-text">{{item.likeCount || 0}}</text>
            </view>
            <view class="action-item" bindtap="onGoPostDetail" data-id="{{item._id}}">
              <text class="action-icon">💬</text>
              <text class="action-text">{{item.commentCount || 0}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 活动 -->
  <view wx:elif="{{currentTab === 1}}" class="tab-panel">
    <view class="activity-list">
      <block wx:if="{{!activities || !activities.length}}">
        <view class="empty-tip">暂时没有活动～</view>
      </block>
      <block wx:for="{{activities}}" wx:key="_id">
        <view class="activity-card" data-id="{{item._id}}" bindtap="onTapEvent">
          <image wx:if="{{item.coverImage}}" class="activity-cover" src="{{item.coverImage}}" mode="aspectFill" />
          <view class="activity-main">
            <text class="activity-title">{{item.title}}</text>
            <text class="activity-sub">{{item.startTimeText}}</text>
            <text class="activity-sub">{{item.location}}</text>
            <text wx:if="{{item.brief}}" class="activity-brief">{{item.brief}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 找校友 -->
  <view wx:elif="{{currentTab === 2}}" class="tab-panel">
    <view class="alumni-filter-card">
      <view class="alumni-filter-row">
        <view class="alumni-filter-item">
          <view class="alumni-filter-pill" bindtap="onPickSchool">
            {{currentSchoolIndex === 0 ? '大学' : schoolOptions[currentSchoolIndex]}}
          </view>
        </view>
        <view class="alumni-filter-item">
          <view class="alumni-filter-pill" bindtap="onPickGrade">
            {{currentGradeIndex === 0 ? '年级' : gradeOptions[currentGradeIndex]}}
          </view>
        </view>
        <view class="alumni-filter-item">
          <view class="alumni-filter-pill" bindtap="onPickMajor">
            {{currentMajorIndex === 0 ? '专业' : majorOptions[currentMajorIndex]}}
          </view>
        </view>
      </view>
    </view>

    <view class="alumni-list">
      <block wx:if="{{!alumniList.length}}">
        <view class="empty-tip">还没有符合条件的校友～</view>
      </block>
      <block wx:for="{{alumniList}}" wx:key="userId">
        <view class="alumni-card" data-user-id="{{item.userId}}" bindtap="onTapUser">
          <image class="alumni-avatar" src="{{item.avatarUrl || 'https://636c-cloud1-7g1x07md7360212c-1406143873.tcb.qcloud.la/%E9%BB%98%E8%AE%A4%E5%A4%B4%E5%83%8F.png?sign=102ca8fc2040a7e360a77f4e14a812fa&t=1774595119'}}" mode="aspectFill" />
          <view class="alumni-info">
            <text class="alumni-name">{{item.nickname}}</text>
            <text class="alumni-desc">
              {{item.schoolName}} · {{item.enterYear}}级 · {{item.major}}
            </text>
            <text class="alumni-location">{{item.city || ''}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 底部选择器（自定义） -->
  <view wx:if="{{pickerVisible}}" class="picker-mask" catchtap="closePicker"></view>
  <view wx:if="{{pickerVisible}}" class="picker-panel">
    <view class="picker-header">
      <text class="picker-cancel" catchtap="closePicker">取消</text>
      <text class="picker-title">{{pickerTitle}}</text>
      <text class="picker-ok" catchtap="closePicker">确定</text>
    </view>
    <scroll-view class="picker-list" scroll-y="true">
      <block wx:for="{{pickerItems}}" wx:key="*this">
        <view class="picker-item" data-index="{{index}}" catchtap="onPickItem">
          {{item}}
        </view>
      </block>
    </scroll-view>
  </view>
</view>